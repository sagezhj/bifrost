	"patterns": [
		{
			"re": "^Page (\\d+) of (\\d+)$",
			"to": "第 $1 页 / 共 $2 页"
		},
		{
			"re": "^Showing (\\d+)[-–—](\\d+) of ([\\d,]+)$",
			"to": "显示第 $1-$2 条 / 共 $3 条"
		},
		{
			"re": "^Showing (\\d+) of ([\\d,]+)$",
			"to": "显示 $1 条 / 共 $2 条"
		},
		{
			"re": "^(\\d+) results?$",
			"to": "$1 条结果"
		},
		{
			"re": "^(\\d+) selected$",
			"to": "已选择 $1 项"
		},
		{
			"re": "^(\\d+) of (\\d+) selected$",
			"to": "已选择 $1 / $2 项"
		},
		{
			"re": "^(\\d+) items?$",
			"to": "$1 项"
		},
		{
			"re": "^in (\\d+) ms$",
			"to": "$1 毫秒"
		},
		{
			"re": "^in ([\\d.]+) s$",
			"to": "$1 秒"
		}
	]
}
